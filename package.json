{
  "name": "pypath",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "assets:pyodide": "node scripts/fetch-pyodide.mjs",
    "assets:editor": "node scripts/build-editor.mjs",
    "assets:sounds": "node scripts/generate-sounds.mjs",
    "prepare:assets": "npm run assets:editor && npm run assets:pyodide && npm run assets:sounds",
    "postinstall": "node scripts/build-editor.mjs && node scripts/fetch-pyodide.mjs --if-missing && node scripts/generate-sounds.mjs --if-missing",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.46.1",
    "@tanstack/react-query": "^5.60.5",
    "expo": "~52.0.11",
    "expo-asset": "~11.0.1",
    "expo-av": "~15.0.1",
    "expo-constants": "~17.0.3",
    "expo-dev-client": "~5.0.4",
    "expo-file-system": "~18.0.4",
    "expo-haptics": "~14.0.0",
    "expo-linking": "~7.0.3",
    "expo-router": "~4.0.9",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "^3.1.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-webview": "13.12.5",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@codemirror/autocomplete": "^6.18.3",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/language": "^6.10.3",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.35.0",
    "@lezer/highlight": "^1.2.1",
    "@types/react": "~18.3.12",
    "esbuild": "^0.24.0",
    "typescript": "~5.3.3"
  }
}
